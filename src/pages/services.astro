---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Businesses" sideBarActiveItemID="services">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Businesses</div>
  </div>

  <HorizontalCard
    title="Infoseer Consulting"
    desc="Co-founded a data analytics and AI consultancy that helps Philippine businesses use their data to make better decisions. Leads client relationships and business strategy — translating what clients need into practical, affordable analytics solutions."
    url="#"
    target="_self"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Online Liquor Delivery Shop"
    desc="Direct-to-consumer liquor sales with delivery operations."
    url="#"
    target="_self"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Pokémon TCG Business"
    desc="Pokémon TCG reselling and community operation."
    url="#"
    target="_self"
  />
</BaseLayout>
